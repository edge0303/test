# ─── 인증 ──────────────────────────────────────────────────
# 관리자로 승격할 이메일 (쉼표 구분). 로그인할 때마다 이 목록이 진실의 원천이 됩니다.
# 비워두면 관리자가 없고 /admin/* 는 누구에게도 열리지 않습니다.
ADMIN_EMAILS=

# 로그인 인증번호 발송. 설정하지 않으면 서버 콘솔에 출력됩니다(로컬 개발용).
# 설정하면 {to, subject, text} JSON 을 이 URL로 POST 합니다.
MAIL_WEBHOOK_URL=

# ─── 외부 데이터 ────────────────────────────────────────────
# 기업마당(bizinfo) 공공데이터 인증키 — https://www.bizinfo.go.kr 에서 발급
# 없으면 seed 데이터로만 동작합니다 (UI에 '샘플 데이터' 배지 표시)
BIZINFO_API_KEY=

# 기업마당 API 엔드포인트 (스펙 변경 시 여기만 수정)
BIZINFO_API_URL=https://www.bizinfo.go.kr/uss/rss/bizinfoApi.do

# 국세청 사업자등록 상태조회 (data.go.kr) — 없으면 형식검증만 수행
NTS_API_KEY=

# ─── 지원서 생성 ────────────────────────────────────────────
# Anthropic API 키 — 없으면 결정적 템플릿 모드로 동작합니다
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
